# Postgres connection string. Used by the app and by drizzle-kit.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Secret used to encrypt the API keys stored in your account.
# Set it to a long random string in production, otherwise the database URL is
# used as a fallback.
# APP_SECRET=change-me

# Optional: Google OAuth for Gmail and YouTube. Set APP_SECRET to a unique,
# random value of at least 32 characters before enabling connections.
# APP_ORIGIN must exactly match the public origin (no trailing slash).
# Register APP_ORIGIN/api/connections/google/callback in your Google OAuth client.
# APP_ORIGIN=https://your-app.example.com
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: GitHub OAuth App for read-only repository listing. Register callback
# APP_ORIGIN/api/connections/github/callback. Does not grant private repo access.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
