# Postgres connection string. Used by the app and by drizzle-kit.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Secret used to encrypt the API keys stored in your account.
# Set it to a long random string in production, otherwise the database URL is
# used as a fallback.
# APP_SECRET=change-me

# Optional Google OAuth (create a Web application client in Google Cloud Console)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
