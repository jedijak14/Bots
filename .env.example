# Postgres connection string. Used by the app and by drizzle-kit.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Secret used to encrypt the API keys stored in your account.
# Set it to a long random string in production, otherwise the database URL is
# used as a fallback.
# APP_SECRET=change-me

# Public URL of the app. Used as the OAuth callback origin when a user connects
# Google, GitHub, Notion, Vercel or Spotify. Falls back to the request host.
# APP_ORIGIN=https://your-app.example.com

# Vercel Blob token, used for avatar uploads. Optional.
# BLOB_READ_WRITE_TOKEN=

# --- Email ----------------------------------------------------------------
# The easiest option needs no environment at all: each person saves a Gmail
# address and a 16-character app password under Settings → Connections → Email.
#
# Deployment-wide Resend (HTTP API — the most reliable option on Vercel, where a
# function stops running as soon as it responds).
# RESEND_API_KEY=re_...
# RESEND_FROM=Bots <bots@your-domain.com>
#
# Or any SMTP relay (Postmark, Fastmail, a company mail server). Port 465 uses
# TLS, 587 uses STARTTLS; port 25 is blocked by Vercel.
# SMTP_HOST=smtp.postmarkapp.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=
# SMTP_FROM=Bots <bots@your-domain.com>
#
# Or the deployment's own Google OAuth client (refresh token needs gmail.send),
# used when nobody has connected Google through Vercel Connect.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
